# Factory local live smoke (P7) — environment template.
# Copy to `.env.live` and fill in the real secrets. `.env.live` is gitignored.
# See docs/runbooks/local-live-smoke.md for how to obtain each value.

# --- Postgres (compose DNS: services reach it as `postgres`) ---
DATABASE_URL=postgres://factory:factory@postgres:5432/factory?sslmode=disable

# --- GitHub App (register one; install on the throwaway repo) ---
# App perms: issues, pull_requests, contents, checks = read & write.
# Events: issues, pull_request, pull_request_review, issue_comment, push.
GITHUB_APP_ID=000000
# PEM private key. In an env file this MUST be a single line with \n escapes, e.g.
# GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----\n
GITHUB_APP_PRIVATE_KEY=
# Webhook secret you set on the App; intake verifies every delivery against it.
GITHUB_WEBHOOK_SECRET=change-me

# --- claude auth (host: `claude login` then `claude setup-token`) ---
# Long-lived token injected into each worker container by the dispatcher.
CLAUDE_CODE_OAUTH_TOKEN=

# --- Azure Blob (Azurite) — checkpoints + transcripts ---
# host.docker.internal:10000 so BOTH the compose Tools service AND the standalone
# worker containers (launched off the compose network) reach the same emulator.
FACTORY_BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://host.docker.internal:10000/devstoreaccount1;

# --- Dispatcher → worker wiring ---
# The worker image DockerLauncher runs (build it: docker build --target worker -t factory-worker:local .)
FACTORY_WORKER_IMAGE=factory-worker:local
# What the dispatcher tells workers to call. Workers aren't on the compose network,
# so this is the HOST-published Tools port, not http://tools:8081.
FACTORY_TOOLS_URL=http://host.docker.internal:8081

# Lease/heartbeat TTL (seconds). Lower = faster crash-resume reclaim; keep > the
# worker heartbeat interval (60s) so a live worker keeps its lease. Default 900.
FACTORY_LEASE_TTL_SECS=120
FACTORY_HEARTBEAT_TTL_SECS=120
